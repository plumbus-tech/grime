    "leftalt": "leftalt",
    "space": "space",
    "rightmeta": "rightmeta",
    "compose": "compose",
    "left": "left",
    "down": "down",
    "right": "right",
    "numlock": "numlock",
    "kpslash": "kpslash",
    "kpasterisk": "kpasterisk",
    "kpminus": "kpminus",
    "kp7": "kp7",
    "kp8": "kp8",
    "kp9": "kp9",
    "kpplus": "kpplus",
    "kp4": "kp4",
    "kp5": "kp5",
    "kp6": "kp6",
    "kp1": "kp1",
    "kp2": "kp2",
    "kp3": "kp3",
    "kpenter": "kpenter",
    "kp0": "kp0",
    "kpdot": "kpdot",
    "mute": "mute",
    "volumedown": "volumedown",
    "volumeup": "volumeup",
    "playpause": "playpause",
    "nextsong": "nextsong",
    "previoussong": "previoussong",
    "brightnessdown": "brightnessdown",
    "brightnessup": "brightnessup",
    "capslock": {
      "press": {
        "then": {
          "h": {
            "press": {
              "do": "tap",
              "key": "left"
            }
          },
          "j": {
            "press": {
              "do": "tap",
              "key": "down"
            }
          },
          "k": {
            "press": {
              "do": "tap",
              "key": "up"
            }
          },
          "l": {
            "press": {
              "do": "tap",
              "key": "right"
            }
          },
          "u": {
            "press": {
              "do": "tap",
              "key": "z",
              "mods": [
                "leftctrl"
              ]
            }
          },
          "t": {
            "press": {
              "do": "exec",
              "cmd": "notify-send grime 'hello from capslock+t'"
            }
          },
          "y": {
            "press": {
              "do": "type",
              "text": "typed by grime!"
            }
          },
          "r": {
            "press": {
              "do": "reload"
            }
          },
          "q": {
            "press": {
              "do": "quit"
            }
          },
          "o": {
            "press": {
              "exit": "toggle",
              "fallthrough": true,
              "do": "exec",
              "argv": [
                "notify-send",
                "grime",
                "override mode toggled (capslock+o)"
              ],
              "then": {
                "leftctrl": {
                  "press": {
                    "do": "press",
                    "key": "leftctrl",
                    "fallthrough": true,
                    "then": {
                      "f": {
                        "press": {
                          "do": "exec",
                          "cmd": "firefox"
                        }
                      },
                      "t": {
                        "press": {
                          "do": "exec",
                          "argv": [
                            "notify-send",
                            "grime",
                            "ctrl+t taken over by grime"
                          ]
                        }
                      }
                    }
                  },
                  "release": {
                    "do": "release",
                    "key": "leftctrl"
                  }
                }
              }
            }
          },
          "d": {
            "press": {
              "exit": "toggle",
              "fallthrough": true,
              "do": "exec",
              "argv": [
                "notify-send",
                "grime",
                "dvorak toggled (capslock+d)"
              ],
              "then": {
                "minus": "leftbrace",
                "equal": "rightbrace",
                "q": "apostrophe",
                "w": "comma",
                "e": "dot",
                "r": "p",
                "t": "y",
                "y": "f",
                "u": "g",
                "i": "c",
                "o": "r",
                "p": "l",
                "leftbrace": "slash",
                "rightbrace": "equal",
                "s": "o",
                "d": "e",
                "f": "u",
                "g": "i",
                "h": "d",
                "j": "h",
                "k": "t",
                "l": "n",
                "semicolon": "s",
                "apostrophe": "minus",
                "z": "semicolon",
                "x": "q",
                "c": "j",
                "v": "k",
                "b": "x",
                "n": "b",
                "comma": "w",
                "dot": "v",
                "slash": "z"
              }
            }
          }
        }
      },
      "release": {
        "alone": true,
        "do": "tap",
        "key": "esc"
      }
    },
    "rightctrl": "rightctrl",
    "rightalt": {
      "press": {
        "exit": "action",
        "then": {
          "x": {
            "press": {
              "exit": "action",
              "then": {
                "f": {
                  "press": {
                    "do": "exec",
                    "cmd": "xdg-open ~"
                  }
                },
                "t": {
                  "press": {
                    "do": "exec",
                    "argv": [
                      "notify-send",
                      "grime",
                      "rightalt x t"
                    ]
                  }
                }
              }
            }
          },
          "l": {
            "press": {
              "do": "log",
              "msg": "rightalt l pressed"
            }
          }
        }
      }
    }
  }
}
