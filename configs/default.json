{
  "devices": [
    "auto"
  ],
  "keymap": {
    "esc": "esc",
    "f1": "f1",
    "f2": "f2",
    "f3": "f3",
    "f4": "f4",
    "f5": "f5",
    "f6": "f6",
    "f7": "f7",
    "f8": "f8",
    "f9": "f9",
    "f10": "f10",
    "f11": "f11",
    "f12": "f12",
    "sysrq": "sysrq",
    "scrolllock": "scrolllock",
    "pause": "pause",
    "grave": "grave",
    "1": "1",
    "2": "2",
    "3": "3",
    "4": "4",
