    "6": "6",
    "7": "7",
    "8": "8",
    "9": "9",
    "0": "0",
    "minus": "minus",
    "equal": "equal",
    "backspace": "backspace",
    "insert": "insert",
    "home": "home",
    "pageup": "pageup",
    "tab": {
      "press": {
        "then": {
          "f": {
            "press": {
              "do": "exec",
              "cmd": "firefox"
            }
          },
          "c": {
            "press": {
              "do": "tap",
              "key": "capslock"
            }
          }
        }
      },
      "release": {
        "alone": true,
        "do": "tap",
        "key": "tab"
      }
    },
    "q": "q",
    "w": "w",
    "e": "e",
    "r": "r",
    "t": "t",
    "y": "y",
    "u": "u",
    "i": "i",
    "o": "o",
    "p": "p",
    "leftbrace": "leftbrace",
    "rightbrace": "rightbrace",
    "backslash": "backslash",
    "delete": "delete",
    "end": "end",
    "pagedown": "pagedown",
    "a": "a",
    "s": "s",
    "d": "d",
    "f": "f",
    "g": "g",
    "h": "h",
    "j": "j",
    "k": "k",
    "l": "l",
    "semicolon": "semicolon",
    "apostrophe": "apostrophe",
    "enter": "enter",
    "leftshift": "leftshift",
    "z": "z",
