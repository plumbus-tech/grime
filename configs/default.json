{
  "devices": ["auto"],
  "base": "qwerty",

  "keymap": {
    "capslock": {
      "tap": "esc",
      "hold": {
        "h": "left", "j": "down", "k": "up", "l": "right",
        "u": "ctrl+z",
        "t": { "do": "exec", "cmd": "notify-send grime 'hello from capslock+t'" },
        "y": { "do": "type", "text": "typed by grime!" },
        "r": { "do": "reload" },
        "q": { "do": "quit" },

        "o": { "toggle": "override", "pass": true,
               "do": "exec", "argv": ["notify-send", "grime", "override mode toggled (capslock+o)"] },
        "d": { "toggle": "dvorak", "pass": true,
               "do": "exec", "argv": ["notify-send", "grime", "dvorak toggled (capslock+d)"] }
      }
    },

    "tab": {
      "tap": "tab",
      "hold": {
        "f": { "do": "exec", "cmd": "firefox" },
        "c": "capslock"
      }
    },

    "rightalt x f": { "do": "exec", "cmd": "xdg-open ~" },
    "rightalt x t": { "do": "exec", "argv": ["notify-send", "grime", "rightalt x t"] },
    "rightalt l":   { "do": "log", "msg": "rightalt l pressed" }
  },

  "layers": {
    "override": {
      "ctrl+f": { "do": "exec", "cmd": "firefox" },
      "ctrl+t": { "do": "exec", "argv": ["notify-send", "grime", "ctrl+t taken over by grime"] }
    },

    "dvorak": {
      "minus": "leftbrace", "equal": "rightbrace",
      "q": "apostrophe", "w": "comma", "e": "dot", "r": "p", "t": "y",
      "y": "f", "u": "g", "i": "c", "o": "r", "p": "l",
      "leftbrace": "slash", "rightbrace": "equal",
      "s": "o", "d": "e", "f": "u", "g": "i", "h": "d",
      "j": "h", "k": "t", "l": "n", "semicolon": "s", "apostrophe": "minus",
      "z": "semicolon", "x": "q", "c": "j", "v": "k", "b": "x",
      "n": "b", "comma": "w", "dot": "v", "slash": "z"
    }
  }
}
